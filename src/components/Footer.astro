---
import { nav, site } from '../data/site';
import { getPI } from '../lib/pi';

const pi = (await getPI()).data;
const year = new Date().getFullYear();
---

<footer class="bg-unb-black text-sm text-gray-300">
  <div class="container-page">
    <!-- Identity + contact -->
    <div class="flex flex-col gap-6 py-8 md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-5">
        <a href={site.universityUrl} title={site.university} class="shrink-0">
          <img src="/images/brand/unb-logo-white.png" alt={site.university} width="439" height="203" class="h-11 w-auto" />
        </a>
        <div class="border-l border-white/15 pl-5">
          <p class="font-serif text-base font-bold text-white">{site.shortName}</p>
          <p class="text-gray-400">{site.department}</p>
        </div>
      </div>

      <div class="space-y-0.5 md:text-right">
        <p>
          <span class="text-white">{pi.name}</span>
          {
            pi.email && (
              <>
                {' · '}
                <a href={`mailto:${pi.email}`} class="text-gray-300 hover:text-white">
                  {pi.email}
                </a>
              </>
            )
          }
        </p>
        <p class="text-gray-400">{site.address}</p>
      </div>
    </div>

    <!-- Links + copyright -->
    <div class="flex flex-col gap-3 border-t border-white/10 py-4 text-xs text-gray-400 md:flex-row md:items-center md:justify-between">
      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-5 gap-y-1">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-gray-300 no-underline hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p>&copy; {year} {site.shortName}, {site.university}</p>
    </div>
  </div>
</footer>
