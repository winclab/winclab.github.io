---
import { nav, pi, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mt-16 bg-unb-black text-gray-300">
  <div class="container-page grid gap-8 py-10 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <p class="font-serif text-lg font-bold text-white">{site.shortName}</p>
      <p class="mt-1 text-sm">{site.name}</p>
      <p class="mt-3 text-sm">
        {site.department}<br />
        <a href={site.universityUrl} class="text-gray-300 hover:text-white">{site.university}</a><br />
        {site.location}
      </p>
    </div>
    <div>
      <p class="mb-2 text-sm font-semibold tracking-wider text-white uppercase">Pages</p>
      <ul class="grid grid-cols-2 gap-1 text-sm">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-gray-300 no-underline hover:text-white hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="mb-2 text-sm font-semibold tracking-wider text-white uppercase">Contact</p>
      <p class="text-sm">
        {pi.name}<br />
        <a href={`mailto:${pi.email}`} class="text-gray-300 hover:text-white">{pi.email}</a>
      </p>
      <p class="mt-2 text-sm">{site.address}</p>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-page py-4 text-xs text-gray-400">
      &copy; {year} {site.shortName}, {site.university}.
    </div>
  </div>
</footer>
