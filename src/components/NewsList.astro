---
// List of news items, used on the Home page (latest few) and the News page (all).
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import PlaceholderBadge from './PlaceholderBadge.astro';

interface Props {
  items: CollectionEntry<'news'>[];
}
const { items } = Astro.props;

const fmt = (d: Date) => d.toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const rendered = await Promise.all(items.map(async (item) => ({ item, Content: (await render(item)).Content })));
---

<ul class="divide-y divide-unb-line border-y border-unb-line">
  {
    rendered.map(({ item, Content }) => (
      <li class="flex flex-col gap-1 py-4 sm:flex-row sm:gap-6">
        <time datetime={item.data.date.toISOString()} class="shrink-0 text-sm font-semibold text-unb-red sm:w-32">
          {fmt(item.data.date)}
        </time>
        <div>
          <p class="font-semibold">
            {item.data.link ? (
              <a href={item.data.link} class="text-unb-black hover:text-unb-dark">
                {item.data.title}
              </a>
            ) : (
              item.data.title
            )}
            {item.data.placeholder && <PlaceholderBadge />}
          </p>
          <div class="prose-lab text-sm text-unb-grey [&_p]:mb-0">
            <Content />
          </div>
        </div>
      </li>
    ))
  }
</ul>
