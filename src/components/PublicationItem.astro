---
import type { CollectionEntry } from 'astro:content';
import PlaceholderBadge from './PlaceholderBadge.astro';

interface Props {
  pub: CollectionEntry<'publications'>;
}
const { pub } = Astro.props;
const { title, authors, venue, year, type, doi, pdf, code, note, placeholder } = pub.data;
const typeLabel: Record<typeof type, string> = {
  journal: 'Journal',
  conference: 'Conference',
  preprint: 'Preprint',
  'book-chapter': 'Book chapter',
  thesis: 'Thesis',
  other: 'Other',
};
const links = [
  doi && { label: 'DOI', href: `https://doi.org/${doi}` },
  pdf && { label: 'PDF', href: pdf },
  code && { label: 'Code', href: code },
].filter(Boolean) as { label: string; href: string }[];
---

<li data-type={type} class="border-l-4 border-unb-line py-1 pl-4 hover:border-unb-red">
  <p class="font-semibold">
    <span class="mr-2 inline-block rounded bg-unb-dark/10 px-1.5 py-0.5 align-middle text-[10px] font-bold tracking-wider text-unb-dark uppercase">
      {typeLabel[type]}
    </span>
    {title}
    {placeholder && <PlaceholderBadge />}
  </p>
  <p class="text-sm text-unb-grey">{authors.join(', ')}</p>
  <p class="text-sm">
    <em>{venue}</em>, {year}
    {note && <span class="ml-2 font-semibold text-unb-red">{note}</span>}
  </p>
  {
    links.length > 0 && (
      <p class="mt-1 flex gap-3 text-sm">
        {links.map((l) => (
          <a href={l.href} class="font-semibold text-unb-dark hover:underline" target="_blank" rel="noopener">
            [{l.label}]
          </a>
        ))}
      </p>
    )
  }
</li>
