---
// Card for a lab member on the People page: photo, name, role, research focus, short bio, profile links.
// The PI uses PIFeature.astro instead.
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import PlaceholderBadge from './PlaceholderBadge.astro';
import ProfileLinks from './ProfileLinks.astro';

interface Props {
  person: CollectionEntry<'people'>;
}
const { person } = Astro.props;
const { name, title, photo, photoPosition, research, now, placeholder } = person.data;
const { Content } = await render(person);
---

<article class="card flex h-full flex-col gap-5 p-5 sm:flex-row sm:p-6">
  <img
    src={photo}
    alt={`Photo of ${name}`}
    width="112"
    height="112"
    loading="lazy"
    class="aspect-square h-24 w-24 shrink-0 rounded-full border-4 border-unb-light bg-unb-light object-cover sm:h-28 sm:w-28"
    style={`object-position: ${photoPosition}`}
  />
  <div class="flex min-w-0 flex-1 flex-col">
    <h3 class="text-lg leading-tight font-semibold">
      {name}
      {placeholder && <PlaceholderBadge />}
    </h3>
    {title && <p class="mt-0.5 text-sm font-semibold text-unb-red">{title}</p>}
    {research && <p class="mt-2 text-sm font-semibold text-unb-black">{research}</p>}
    {now && <p class="mt-2 text-sm text-unb-grey">Now: {now}</p>}
    <div class="prose-lab mt-2 text-sm leading-relaxed text-unb-grey [&_p]:mb-2 [&_p:last-child]:mb-0">
      <Content />
    </div>
    <div class="mt-auto pt-4">
      <ProfileLinks person={person.data} />
    </div>
  </div>
</article>
