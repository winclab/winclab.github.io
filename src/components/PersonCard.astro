---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import PlaceholderBadge from './PlaceholderBadge.astro';

interface Props {
  person: CollectionEntry<'people'>;
}
const { person } = Astro.props;
const { name, role, title, subtitle, photo, photoPosition, email, website, linkedin, scholar, research, now, placeholder } =
  person.data;
const isPI = role === 'pi';
// The PI's Markdown body is the full biography shown on /pi, so the card links there instead.
const { Content } = await render(person);

const links = [
  isPI && { label: 'Full bio', href: '/pi' },
  email && { label: 'Email', href: `mailto:${email}` },
  scholar && { label: 'Scholar', href: scholar },
  website && { label: 'Website', href: website },
  linkedin && { label: 'LinkedIn', href: linkedin },
].filter(Boolean) as { label: string; href: string }[];
---

<article class="card flex h-full flex-col items-center text-center">
  <img
    src={photo}
    alt={`Photo of ${name}`}
    width="160"
    height="160"
    loading="lazy"
    class="aspect-square h-32 w-32 rounded-full border-4 border-unb-light bg-unb-light object-cover"
    style={`object-position: ${photoPosition}`}
  />
  <h3 class="mt-4 text-lg font-semibold">
    {name}
    {placeholder && <PlaceholderBadge />}
  </h3>
  {title && <p class="text-sm font-semibold text-unb-red">{title}</p>}
  {subtitle && <p class="text-sm font-semibold text-unb-red">{subtitle}</p>}
  {research && <p class="mt-2 text-sm text-unb-grey">{research}</p>}
  {now && <p class="mt-2 text-sm text-unb-grey">Now: {now}</p>}
  {!isPI && <div class="prose-lab mt-2 text-sm text-unb-grey [&_p]:mb-0"><Content /></div>}
  {
    links.length > 0 && (
      <div class="mt-auto flex flex-wrap justify-center gap-x-4 gap-y-1 pt-4 text-sm font-semibold">
        {links.map((l) => (
          <a
            href={l.href}
            class="text-unb-dark hover:underline"
            target={l.href.startsWith('http') ? '_blank' : undefined}
            rel={l.href.startsWith('http') ? 'noopener' : undefined}
          >
            {l.label}
          </a>
        ))}
      </div>
    )
  }
</article>
