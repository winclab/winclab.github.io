---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { program, acknowledgements } from '../data/research';
import { sponsors } from '../data/sponsors';
import { pi } from '../data/site';

const pubs = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title),
);
const years = [...new Set(pubs.map((p) => p.data.year))];

// Filter buttons: "All" plus one per publication type that actually appears.
const typeNames: Record<string, string> = {
  journal: 'Journals',
  conference: 'Conferences',
  preprint: 'Preprints',
  'book-chapter': 'Book chapters',
  thesis: 'Theses',
  other: 'Other',
};
const filters = [
  { key: 'all', label: 'All', count: pubs.length },
  ...Object.keys(typeNames)
    .map((key) => ({ key, label: typeNames[key], count: pubs.filter((p) => p.data.type === key).length }))
    .filter((f) => f.count > 0),
];

const sections = [
  { id: 'program', label: 'Research program' },
  { id: 'challenges', label: 'Challenges & directions' },
  { id: 'publications', label: 'Publications' },
];
---

<BaseLayout title="Research" description={`Current research program: ${program.title}.`}>
  <PageHeader eyebrow="Current research program" title={program.title} />

  <!-- In-page navigation -->
  <nav aria-label="On this page" class="sticky top-16 z-30 border-b border-unb-line bg-white/95 backdrop-blur">
    <ul class="container-page flex gap-1 overflow-x-auto py-2 text-sm font-semibold whitespace-nowrap">
      {
        sections.map((s) => (
          <li>
            <a href={`#${s.id}`} class="block rounded px-3 py-1.5 text-unb-grey no-underline hover:bg-unb-light hover:text-unb-dark">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <section id="program" class="container-page scroll-mt-32 py-12">
    <div class="grid items-start gap-8 lg:grid-cols-[3fr_2fr]">
      <figure class="card p-3">
        <a href={program.figure.src} target="_blank" rel="noopener" title="Open full-size figure">
          <img src={program.figure.src} alt={program.figure.alt} width="951" height="684" class="h-auto w-full rounded" />
        </a>
        <figcaption class="px-2 pt-3 text-sm text-unb-grey">{program.figure.caption}</figcaption>
      </figure>

      <div>
        <div class="rounded-lg border-l-4 border-unb-dark bg-unb-light p-6">
          <p class="eyebrow">Goal</p>
          <p class="text-lg">{program.goal}</p>
        </div>
        <p class="mt-6 mb-2 text-sm font-semibold tracking-wider text-unb-grey uppercase">Application scenarios</p>
        <ul class="flex flex-wrap gap-2">
          {program.applications.map((a) => <li class="rounded-full bg-unb-dark px-3 py-1 text-sm font-semibold text-white">{a}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="challenges" class="scroll-mt-32 bg-unb-light py-12">
    <div class="container-page">
      <h2 class="section-title">Key challenges and research directions</h2>
      <ol class="grid gap-5 md:grid-cols-3">
        {
          program.subtasks.map((t, i) => (
            <li class="card flex flex-col border-t-4 border-t-unb-red">
              <p class="font-serif text-3xl font-bold text-unb-red/40">0{i + 1}</p>
              <p class="mt-2 text-xs font-bold tracking-wider text-unb-grey uppercase">Challenge</p>
              <p class="mt-1">{t.challenge}</p>
              <p class="mt-4 text-xs font-bold tracking-wider text-unb-red uppercase">Research direction</p>
              <p class="mt-1 font-serif text-lg font-semibold text-unb-dark">{t.direction}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="publications" class="container-page scroll-mt-32 py-12">
    <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-2xl font-semibold sm:text-3xl">Publications</h2>
      <a href={pi.links.scholar} class="text-sm font-semibold text-unb-dark hover:underline" target="_blank" rel="noopener">
        Full list on Google Scholar →
      </a>
    </div>

    {
      filters.length > 2 && (
        <div class="mb-8 flex flex-wrap gap-2" role="group" aria-label="Filter publications by type">
          {filters.map((f, i) => (
            <button
              type="button"
              data-filter={f.key}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="pub-filter rounded-full border border-unb-dark/30 px-4 py-1.5 text-sm font-semibold text-unb-dark transition-colors hover:border-unb-dark aria-pressed:border-unb-dark aria-pressed:bg-unb-dark aria-pressed:text-white"
            >
              {f.label} <span class="opacity-70">({f.count})</span>
            </button>
          ))}
        </div>
      )
    }

    {pubs.length === 0 && <p class="text-unb-grey">No publications yet.</p>}
    {
      years.map((year) => (
        <div class="pub-year mb-8">
          <h3 class="mb-3 border-b border-unb-line pb-1 font-serif text-xl font-semibold text-unb-red">{year}</h3>
          <ul class="space-y-4">
            {pubs
              .filter((p) => p.data.year === year)
              .map((p) => (
                <PublicationItem pub={p} />
              ))}
          </ul>
        </div>
      ))
    }
  </section>

  <!-- Acknowledgements -->
  <section aria-labelledby="ack-heading" class="border-t border-unb-line bg-unb-light/60">
    <div class="container-page grid items-center gap-6 py-10 md:grid-cols-[1fr_auto]">
      <div>
        <h2 id="ack-heading" class="text-lg font-semibold">Acknowledgements</h2>
        <p class="mt-1 text-sm text-unb-grey">This research is supported in part by:</p>
        <ul class="mt-2 list-disc space-y-0.5 pl-5 text-sm text-unb-grey">
          {acknowledgements.map((a) => <li>{a}</li>)}
        </ul>
      </div>
      <ul class="flex flex-wrap items-center gap-6">
        {
          sponsors.map((s) => (
            <li>
              <img src={s.logo} alt={s.name} title={s.name} class="h-10 w-auto" loading="lazy" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.pub-filter');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const key = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      document.querySelectorAll<HTMLElement>('.pub-year').forEach((group) => {
        let visible = 0;
        group.querySelectorAll<HTMLElement>('li[data-type]').forEach((li) => {
          const show = key === 'all' || li.dataset.type === key;
          li.hidden = !show;
          if (show) visible++;
        });
        group.hidden = visible === 0;
      });
    }),
  );
</script>
