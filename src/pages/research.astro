---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { program, acknowledgements } from '../data/research';
import { sponsors } from '../data/sponsors';
import { getPI } from '../lib/pi';

const pi = (await getPI()).data;
const pubs = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title),
);
const years = [...new Set(pubs.map((p) => p.data.year))];

// Filter buttons: "All" plus one per publication type that actually appears.
const typeNames: Record<string, string> = {
  journal: 'Journals',
  conference: 'Conferences',
  preprint: 'Preprints',
  'book-chapter': 'Book chapters',
  thesis: 'Theses',
  other: 'Other',
};
const filters = [
  { key: 'all', label: 'All', count: pubs.length },
  ...Object.keys(typeNames)
    .map((key) => ({ key, label: typeNames[key], count: pubs.filter((p) => p.data.type === key).length }))
    .filter((f) => f.count > 0),
];

---

<BaseLayout title="Research" description={`Current research program: ${program.title}.`}>
  <PageHeader eyebrow="Current research program" title={program.title} />

  <!-- Program: goal, then full-width figure -->
  <section id="program" class="container-page py-12 sm:py-16">
    <div class="mx-auto max-w-4xl">
      <p class="eyebrow">Goal</p>
      <p class="font-serif text-2xl leading-snug text-unb-black sm:text-3xl">{program.goal}</p>

      <figure class="mt-10">
        <a href={program.figure.src} target="_blank" rel="noopener" title="Open full-size figure" class="block">
          <img
            src={program.figure.src}
            alt={program.figure.alt}
            width="951"
            height="684"
            class="h-auto w-full rounded-lg border border-unb-line bg-white p-2 shadow-sm sm:p-4"
          />
        </a>
        <figcaption class="mt-4 flex flex-col gap-3 text-sm text-unb-grey sm:flex-row sm:items-center sm:justify-between">
          <span>{program.figure.caption}</span>
          <span class="flex flex-wrap gap-2">
            {program.applications.map((a) => (
              <span class="rounded-full border border-unb-dark/25 px-3 py-0.5 text-xs font-semibold text-unb-dark">{a}</span>
            ))}
          </span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Challenges and directions -->
  <section id="challenges" class="bg-unb-light py-12 sm:py-16">
    <div class="container-page">
      <div class="mx-auto max-w-4xl">
        <h2 class="section-title">Key challenges and research directions</h2>
        <div class="hidden grid-cols-[3rem_1fr_1fr] gap-6 border-b border-unb-line pb-2 text-xs font-bold tracking-wider uppercase md:grid">
          <span></span>
          <span class="text-unb-grey">Challenge</span>
          <span class="text-unb-red">Research direction</span>
        </div>
        <ol class="divide-y divide-unb-line">
          {
            program.subtasks.map((t, i) => (
              <li class="grid gap-2 py-6 md:grid-cols-[3rem_1fr_1fr] md:gap-6">
                <span class="font-serif text-2xl font-bold text-unb-red">0{i + 1}</span>
                <div>
                  <p class="text-xs font-bold tracking-wider text-unb-grey uppercase md:hidden">Challenge</p>
                  <p class="text-unb-grey">{t.challenge}</p>
                </div>
                <div class="md:border-l-2 md:border-unb-red md:pl-6">
                  <p class="mt-2 text-xs font-bold tracking-wider text-unb-red uppercase md:hidden">Research direction</p>
                  <p class="font-serif text-lg leading-snug font-semibold text-unb-dark">{t.direction}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section id="publications" class="container-page py-12 sm:py-16">
    <div class="mx-auto max-w-4xl">
    <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-2xl font-semibold sm:text-3xl">Publications</h2>
      <a href={pi.scholar ?? 'https://scholar.google.com/'} class="text-sm font-semibold text-unb-dark hover:underline" target="_blank" rel="noopener">
        Full list on Google Scholar →
      </a>
    </div>

    {
      filters.length > 2 && (
        <div class="mb-8 flex flex-wrap gap-2" role="group" aria-label="Filter publications by type">
          {filters.map((f, i) => (
            <button
              type="button"
              data-filter={f.key}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="pub-filter rounded-full border border-unb-dark/30 px-4 py-1.5 text-sm font-semibold text-unb-dark transition-colors hover:border-unb-dark aria-pressed:border-unb-dark aria-pressed:bg-unb-dark aria-pressed:text-white"
            >
              {f.label} <span class="opacity-70">({f.count})</span>
            </button>
          ))}
        </div>
      )
    }

    {pubs.length === 0 && <p class="text-unb-grey">No publications yet.</p>}
    {
      years.map((year) => (
        <div class="pub-year mb-8">
          <h3 class="mb-3 border-b border-unb-line pb-1 font-serif text-xl font-semibold text-unb-red">{year}</h3>
          <ul class="space-y-4">
            {pubs
              .filter((p) => p.data.year === year)
              .map((p) => (
                <PublicationItem pub={p} />
              ))}
          </ul>
        </div>
      ))
    }
    </div>
  </section>

  <!-- Acknowledgements -->
  <section aria-labelledby="ack-heading" class="border-t border-unb-line bg-unb-light/60">
    <div class="container-page"><div class="mx-auto grid max-w-4xl items-center gap-6 py-10 md:grid-cols-[1fr_auto]">
      <div>
        <h2 id="ack-heading" class="text-lg font-semibold">Acknowledgements</h2>
        <p class="mt-1 text-sm text-unb-grey">This research is supported in part by:</p>
        <ul class="mt-2 list-disc space-y-0.5 pl-5 text-sm text-unb-grey">
          {acknowledgements.map((a) => <li>{a}</li>)}
        </ul>
      </div>
      <ul class="flex flex-wrap items-center gap-6">
        {
          sponsors.map((s) => (
            <li>
              <img src={s.logo} alt={s.name} title={s.name} class="h-10 w-auto" loading="lazy" />
            </li>
          ))
        }
      </ul>
    </div>
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.pub-filter');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const key = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      document.querySelectorAll<HTMLElement>('.pub-year').forEach((group) => {
        let visible = 0;
        group.querySelectorAll<HTMLElement>('li[data-type]').forEach((li) => {
          const show = key === 'all' || li.dataset.type === key;
          li.hidden = !show;
          if (show) visible++;
        });
        group.hidden = visible === 0;
      });
    }),
  );
</script>
