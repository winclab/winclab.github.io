---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroGraphic from '../components/HeroGraphic.astro';
import NewsList from '../components/NewsList.astro';
import { site } from '../data/site';
import { getPI } from '../lib/pi';
import { summary, mission } from '../data/research';
import { sponsors } from '../data/sponsors';

const pi = (await getPI()).data;
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const cards = [
  { title: 'About', href: '/about', text: 'Who we are, our research directions, and areas of interest.' },
  { title: 'Research', href: '/research', text: 'Edge AI-empowered semantic communication networks for intelligent IoT, and our publications.' },
  { title: 'PI', href: '/pi', text: `Meet ${pi.name}, ${pi.subtitle}.` },
  { title: 'People', href: '/people', text: 'The students, researchers, and alumni of the lab.' },
  { title: 'Gallery', href: '/gallery', text: 'Photos from the lab, conferences, and events.' },
  { title: 'Join Us', href: '/join', text: 'Open positions and how to apply.' },
];

---

<BaseLayout>
  <!-- Hero -->
  <section class="bg-unb-light">
    <div class="container-page grid items-center gap-10 py-14 md:grid-cols-2 md:py-20">
      <div>
        <p class="eyebrow">{site.university} · {site.department}</p>
        <h1 class="text-4xl leading-tight font-bold sm:text-5xl">{site.name}</h1>
        <p class="mt-5 text-lg text-unb-grey">{summary} {mission}</p>
        <p class="mt-3 text-sm text-unb-grey">Led by {pi.name}, {pi.title} and {pi.subtitle}.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/research" class="btn btn-primary">See our research</a>
          <a href="/join" class="btn btn-outline">Join us</a>
        </div>
      </div>
      <div class="mx-auto w-full max-w-md">
        <HeroGraphic />
      </div>
    </div>
  </section>

  <!-- Explore cards -->
  <section class="container-page py-14">
    <h2 class="section-title">Explore the lab</h2>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        cards.map((c) => (
          <a href={c.href} class="card group block no-underline transition hover:-translate-y-0.5 hover:border-unb-red hover:shadow-md">
            <h3 class="text-xl font-semibold group-hover:text-unb-dark">
              {c.title} <span aria-hidden="true" class="text-unb-red">→</span>
            </h3>
            <p class="mt-2 text-unb-grey">{c.text}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- News -->
  {
    news.length > 0 && (
      <section class="container-page pb-14">
        <div class="mb-6 flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="text-2xl font-semibold sm:text-3xl">Latest news</h2>
          <a href="/news" class="text-sm font-semibold text-unb-dark hover:underline">
            All news →
          </a>
        </div>
        <NewsList items={news} />
      </section>
    )
  }

  <!-- Sponsors -->
  <section class="container-page py-14">
    <h2 class="mb-8 text-center text-sm font-bold tracking-widest text-unb-grey uppercase">Supported by</h2>
    <ul class="flex flex-wrap items-center justify-center gap-x-12 gap-y-8">
      {
        sponsors.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener" title={s.name} class="block opacity-80 transition hover:opacity-100">
              <img src={s.logo} alt={s.name} class="h-12 w-auto" loading="lazy" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
