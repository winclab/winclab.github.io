---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import DirectionFigure from '../components/DirectionFigure.astro';
import { site } from '../data/site';
import { getPI } from '../lib/pi';
import { summary, mission, directions, interests } from '../data/research';

const pi = (await getPI()).data;
---

<BaseLayout title="About" description={summary}>
  <PageHeader eyebrow="About" title={site.name} intro={summary} />

  <section class="container-page py-12">
    <div class="prose-lab max-w-3xl text-lg">
      <p>{mission}</p>
      <p>
        The {site.shortName} is part of the {site.department} at the {site.university}, led by {pi.name}, {pi.title} and {pi.subtitle}.
      </p>
    </div>
  </section>

  <section class="bg-unb-light py-12">
    <div class="container-page">
      <h2 class="section-title">Research directions</h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          directions.map((d) => (
            <article class="card flex flex-col p-0">
              <div class="p-3 pb-0">
                <DirectionFigure figure={d.figure} title={d.title} />
              </div>
              <div class="p-5">
                <h3 class="text-xl font-semibold">{d.title}</h3>
                <ul class="mt-3 space-y-2 text-unb-grey">
                  {d.points.map((p) => (
                    <li class="flex gap-2">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-unb-red" aria-hidden="true" />
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-page py-12">
    <h2 class="section-title">Areas of interest</h2>
    <ul class="flex flex-wrap gap-2">
      {
        interests.map((t) => (
          <li class="rounded-full border border-unb-dark/30 bg-white px-4 py-1.5 text-sm font-semibold text-unb-dark">{t}</li>
        ))
      }
    </ul>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/research" class="btn btn-primary">Current research program</a>
      <a href="/people" class="btn btn-outline">Meet the team</a>
    </div>
  </section>
</BaseLayout>
