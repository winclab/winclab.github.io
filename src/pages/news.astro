---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import NewsList from '../components/NewsList.astro';

const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const years = [...new Set(news.map((n) => n.data.date.getUTCFullYear()))];
---

<BaseLayout title="News" description="News and announcements from the WINC Lab.">
  <PageHeader eyebrow="News" title="Lab news" intro="Papers, awards, new members, talks, and other updates from the WINC Lab." />

  <section class="container-page py-12">
    {news.length === 0 && <p class="text-unb-grey">No news yet.</p>}
    {
      years.map((year) => (
        <div class="mb-10">
          <h2 class="mb-3 font-serif text-xl font-semibold text-unb-red">{year}</h2>
          <NewsList items={news.filter((n) => n.data.date.getUTCFullYear() === year)} />
        </div>
      ))
    }
  </section>
</BaseLayout>
