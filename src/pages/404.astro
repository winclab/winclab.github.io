---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="container-page py-24 text-center">
    <p class="font-serif text-6xl font-bold text-unb-red">404</p>
    <h1 class="mt-4 text-2xl font-semibold">Page not found</h1>
    <p class="mt-2 text-unb-grey">The page you are looking for does not exist or has moved.</p>
    <a href="/" class="btn btn-primary mt-8">Back to home</a>
  </section>
</BaseLayout>
