---
// Text for this page lives in src/data/join.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getPI } from '../lib/pi';
import {
  openings,
  topics,
  requirements,
  benefits,
  paths,
  applySubject,
  applyMaterials,
  links,
  faqs,
} from '../data/join';

const pi = (await getPI()).data;
const mailto = `mailto:${pi.email}?subject=${encodeURIComponent(applySubject)}`;
---

<BaseLayout title="Join Us" description="Open PhD positions and how to join the WINC Lab at the University of New Brunswick.">
  <PageHeader
    eyebrow="Join Us"
    title="Work with us"
    intro="We are looking for curious, self-motivated people who want to build the next generation of intelligent wireless networks."
  />

  <!-- Current openings -->
  <section class="container-page pt-12">
    <div class="mx-auto max-w-5xl">
      {
        openings.length > 0 ? (
          <div class="grid gap-4 md:grid-cols-[1fr_auto] md:items-center rounded-lg bg-unb-dark p-6 text-white sm:p-8">
            <div>
              <p class="text-xs font-bold tracking-widest text-white/70 uppercase">Now recruiting</p>
              {openings.map((o) => (
                <div class="mt-2">
                  <p class="font-serif text-2xl font-semibold">{o.title}</p>
                  <p class="text-white/85">
                    {o.start}
                    {o.details && <span> · {o.details}</span>}
                  </p>
                </div>
              ))}
            </div>
            <a href="#apply" class="btn bg-white text-unb-dark hover:bg-unb-light">
              How to apply ↓
            </a>
          </div>
        ) : (
          <div class="rounded-lg border border-unb-line bg-unb-light p-6">
            <p class="font-semibold">No positions are advertised right now.</p>
            <p class="mt-1 text-unb-grey">Exceptional candidates are still welcome to get in touch. See how to apply below.</p>
          </div>
        )
      }
    </div>
  </section>

  <!-- Ways to join -->
  <section class="container-page py-12">
    <div class="mx-auto max-w-5xl">
      <h2 class="section-title">Ways to work with the lab</h2>
      <div class="grid gap-5 sm:grid-cols-2">
        {
          paths.map((p) => (
            <article class="card">
              <h3 class="text-lg font-semibold text-unb-dark">{p.title}</h3>
              <p class="mt-2 text-unb-grey">{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Topics, requirements, benefits -->
  <section class="bg-unb-light py-12">
    <div class="container-page">
      <div class="mx-auto max-w-5xl">
        <h2 class="section-title">Research topics</h2>
        <ul class="flex flex-wrap gap-2">
          {topics.map((t) => <li class="rounded-full border border-unb-dark/30 bg-white px-4 py-1.5 text-sm font-semibold text-unb-dark">{t}</li>)}
        </ul>

        <div class="mt-10 grid gap-6 md:grid-cols-2">
          <div class="card">
            <h3 class="text-lg font-semibold">What we look for</h3>
            <ul class="mt-3 space-y-2 text-unb-grey">
              {
                requirements.map((r) => (
                  <li class="flex gap-2">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-unb-red" aria-hidden="true" />
                    <span>{r}</span>
                  </li>
                ))
              }
            </ul>
            <p class="mt-4 text-sm">
              <a href={links.eceProgram} target="_blank" rel="noopener" class="font-semibold text-unb-dark">
                UNB ECE admission and English requirements →
              </a>
            </p>
          </div>
          <div class="card">
            <h3 class="text-lg font-semibold">What we offer</h3>
            <ul class="mt-3 space-y-2 text-unb-grey">
              {
                benefits.map((b) => (
                  <li class="flex gap-2">
                    <span class="font-bold text-unb-red" aria-hidden="true">✓</span>
                    <span>{b}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How to apply -->
  <section id="apply" class="container-page scroll-mt-20 py-12">
    <div class="mx-auto max-w-5xl">
      <div class="max-w-3xl">
      <h2 class="section-title">How to apply</h2>

      <ol class="space-y-6">
        <li class="flex gap-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-unb-dark font-bold text-white">1</span>
          <div>
            <p class="font-semibold">Get to know our work</p>
            <p class="text-unb-grey">
              Read some of our <a href="/research#publications" class="text-unb-dark">publications</a> and{' '}
              <a href="/about" class="text-unb-dark">research directions</a>. Applicants who show genuine, specific interest have a much
              better chance.
            </p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-unb-dark font-bold text-white">2</span>
          <div class="min-w-0">
            <p class="font-semibold">Email {pi.name}</p>
            <p class="text-unb-grey">
              Send to <a href={mailto} class="font-semibold text-unb-dark">{pi.email}</a> with:
            </p>
            <ul class="mt-2 list-disc pl-5 text-unb-grey">
              {applyMaterials.map((m) => <li>{m}</li>)}
            </ul>
            <p class="mt-3 text-unb-grey">Use this subject line:</p>
            <p class="mt-1 rounded border border-unb-line bg-unb-light px-4 py-3 font-mono text-sm wrap-break-word">{applySubject}</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-unb-dark font-bold text-white">3</span>
          <div>
            <p class="font-semibold">Apply formally to UNB</p>
            <p class="text-unb-grey">
              If you are selected, you will also apply through UNB’s official graduate admissions process. See the details below.
            </p>
          </div>
        </li>
      </ol>

      <div class="mt-8 rounded-lg border-l-4 border-unb-red bg-unb-light p-5 text-sm">
        <p><strong>AI-generated emails will be ignored.</strong> Please write your own message.</p>
        <p class="mt-1 text-unb-grey">Due to the volume of applications, only selected applicants will be contacted.</p>
      </div>

      </div>
    </div>
  </section>

  <!-- Admissions and funding -->
  <section class="bg-unb-light py-12">
    <div class="container-page">
      <div class="mx-auto max-w-5xl">
        <h2 class="section-title">Admissions and funding</h2>
        <div class="grid gap-6 md:grid-cols-2">
          <article class="card border-t-4 border-t-unb-dark">
            <h3 class="text-lg font-semibold">Formal application to UNB</h3>
            <div class="prose-lab mt-3 text-unb-grey">
              <p>
                Follow UNB’s official graduate admissions process and apply through the{' '}
                <a href={links.gradStudies} target="_blank" rel="noopener">UNB School of Graduate Studies</a>. Program requirements
                and deadlines are listed on the{' '}
                <a href={links.eceProgram} target="_blank" rel="noopener">ECE graduate program page</a>.
              </p>
              <p class="mb-0!">Indicate {pi.name} as your intended supervisor.</p>
            </div>
          </article>
          <article class="card border-t-4 border-t-unb-dark">
            <h3 class="text-lg font-semibold">Funding and scholarships</h3>
            <dl class="mt-3 space-y-3 text-unb-grey">
              <div>
                <dt class="font-semibold text-unb-black">Lab funding</dt>
                <dd>Full financial support is available for exceptional candidates.</dd>
              </div>
              <div>
                <dt class="font-semibold text-unb-black">Teaching assistantships</dt>
                <dd>TA positions are available. Once you join UNB, you apply for them separately each semester.</dd>
              </div>
              <div>
                <dt class="font-semibold text-unb-black">UNB scholarships</dt>
                <dd>
                  UNB offers entrance scholarships for graduate students. See the{' '}
                  <a href={links.gradStudies} target="_blank" rel="noopener" class="text-unb-dark underline">School of Graduate Studies</a>{' '}
                  for current awards.
                </dd>
              </div>
            </dl>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-page py-12">
    <div class="mx-auto max-w-5xl">
      <h2 class="section-title">Frequently asked questions</h2>
      <div class="max-w-3xl divide-y divide-unb-line border-y border-unb-line">
        {
          faqs.map((f) => (
            <details class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-serif text-lg font-semibold text-unb-black transition-colors hover:text-unb-dark group-open:text-unb-dark">
                {f.q}
                <span
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-unb-dark/30 font-sans text-base text-unb-dark transition group-open:rotate-45 group-open:border-unb-dark group-open:bg-unb-dark group-open:text-white"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <div class="prose-lab pb-5 text-unb-grey">
                <p class="mb-0!" set:html={f.a} />
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
