---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { pi } from '../data/site';

// Buttons appear only for links that are filled in src/data/site.ts.
const buttons = [
  { label: 'Google Scholar', href: pi.links.scholar },
  { label: 'UNB Profile', href: pi.links.unb },
  { label: 'Email', href: `mailto:${pi.email}` },
  { label: 'LinkedIn', href: pi.links.linkedin },
  { label: 'ORCID', href: pi.links.orcid },
  { label: 'GitHub', href: pi.links.github },
  { label: 'CV', href: pi.links.cv },
].filter((b) => b.href);
---

<BaseLayout title={pi.name} description={`${pi.name}, ${pi.title} and ${pi.chair}, ${pi.university}.`}>
  <PageHeader eyebrow="Principal Investigator" title={pi.name} />

  <section class="container-page grid gap-10 py-12 md:grid-cols-[280px_1fr]">
    <div>
      <img
        src={pi.photo}
        alt={`Photo of ${pi.name}`}
        width="560"
        height="700"
        class="w-full max-w-xs rounded-lg border border-unb-line bg-unb-light object-cover shadow-sm"
      />
      <p class="mt-4 font-semibold">{pi.title}</p>
      <p class="font-semibold text-unb-red">{pi.chair}</p>
      <p class="mt-1 text-sm text-unb-grey">{pi.department}<br />{pi.university}</p>
      <p class="mt-2 text-sm"><a href={`mailto:${pi.email}`} class="text-unb-dark">{pi.email}</a></p>
    </div>

    <div>
      <div class="flex flex-wrap gap-2">
        {
          buttons.map((b, i) => (
            <a
              href={b.href}
              class:list={['btn', i === 0 ? 'btn-primary' : 'btn-outline']}
              target={b.href.startsWith('http') ? '_blank' : undefined}
              rel={b.href.startsWith('http') ? 'noopener' : undefined}
            >
              {b.label}
            </a>
          ))
        }
      </div>

      <h2 class="mt-10 mb-4 text-2xl font-semibold">Biography</h2>
      <div class="prose-lab max-w-3xl text-lg">
        <!-- [PLACEHOLDER] Replace the biography below with Dr. Chen's real bio. -->
        <p>
          [PLACEHOLDER] {pi.name} is an {pi.title} in the {pi.department} at the {pi.university}, holds the {pi.chair},
          and leads the Wireless Intelligent Networking and Computing (WINC) Lab.
        </p>
        <p>
          [PLACEHOLDER] Education: PhD in ... from ..., followed by postdoctoral research at .... Research interests
          include wireless networking, the Internet of Things, and edge intelligence.
        </p>
        <p>[PLACEHOLDER] Selected honours, editorial roles, and professional service.</p>
      </div>
    </div>
  </section>
</BaseLayout>
